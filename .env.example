# Copia este archivo como .env (no se sube a GitHub).
# Docker Compose lo lee solo; sin Docker, expórtalas o cárgalas en tu terminal.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
# Hosts permitidos (separados por coma). Vacío = solo localhost en modo DEBUG.
ALLOWED_HOSTS=

# Base de datos MySQL/MariaDB. Con Docker solo necesitas DB_PASSWORD.
DB_NAME=tienda
DB_USER=root
DB_PASSWORD=cambia-esta-clave
DB_HOST=localhost
DB_PORT=3306
